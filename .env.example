# Copy to .env and fill in. Never commit the real .env file.

# Required for AI features. Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=8080
AI_TIMEOUT_MS=30000
AI_THINKING_LEVEL=LOW
AIR_TIMEOUT_MS=8000
RATE_LIMIT_PER_MINUTE=20
CACHE_TTL_MS=600000
TRUST_PROXY=1
